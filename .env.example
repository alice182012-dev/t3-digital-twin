MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
INITIAL_WL_MINIO_BUCKET=initial-wl
INITIAL_WL_MINIO_PREFIX=dummy-files
MANHOLES_MINIO_BUCKET=manholes-data
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

DJANGO_SECRET_KEY=change-me-django-secret
DJANGO_DEBUG=false
POSTGRES_DB=minio_custom
POSTGRES_USER=minio_custom
POSTGRES_PASSWORD=change-me-storage-postgres-password
POSTGRES_HOST_PORT=5432
ROUTING_READER_USER=routing_reader
ROUTING_READER_PASSWORD=change-me-routing-reader-password
ANALYSIS_READER_USER=analysis_reader
ANALYSIS_READER_PASSWORD=change-me-analysis-reader-password
GUNICORN_WORKERS=2

TIMESCALE_DB=flood_metrics
TIMESCALE_USER=flood_metrics
TIMESCALE_PASSWORD=change-me-timescale-password
TIMESCALE_HOST_PORT=5434

AIRFLOW_UID=50000
AIRFLOW_PORT=8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
_PIP_ADDITIONAL_REQUIREMENTS=
FLOOD_USE_DOWNLOADED_RESULTS=false
KEEP_LOCAL_GEOJSON=false
MODEL_ID=83022
ORG_UUID=905acb81673846f3b2f970e83b3af32a
THREEDI_API_KEY=Basic change-me-3di-api-key
THREEDI_API_PERSONAL_API_TOKEN=change-me-3di-personal-api-token
TOMORROW_API_KEY=change-me-tomorrow-api-key
UPDATE_INTERVAL=900
MAX_WORKERS=1
SAMPLE_RATE=1
# Celery worker concurrency (compose.yml AIRFLOW__CELERY__WORKER_CONCURRENCY, default 1). 4 is
# recommended, but raise it only together with giving 3_calculate_depth its own single-slot
# `depth_calc` Airflow pool (see artifacts/docs/blockers/flood-mapping-full-worker-concurrency-
# serializes-runs.md); raising this alone risks two CPU-bound depth-calc tasks running at once
# and oversubscribing the host.
AIRFLOW_WORKER_CONCURRENCY=4
MIN_DEPTH_THRESHOLD=0
SIMULATION_DURATION=7200
AIRFLOW_TASK_HEARTBEAT_TIMEOUT=1800
AIRFLOW_EXECUTION_API_JWT_EXPIRATION_TIME=14400
# Optional local-only override. Leave blank for live Tomorrow.io rainfall.
FLOOD_TEST_RAIN_MM_HR=
# Optional local-only replay of a recorded event. Set both, and leave FLOOD_TEST_RAIN_MM_HR blank.
# The file has offset_minutes,precipitation_mm_hr rows. The start is the UTC time of offset 0, on a 15-minute slot.
# On the server, set and clear these keys and the gate with scripts\rain_env\replay.ps1 start, stop, and status.
FLOOD_TEST_RAIN_CSV=
FLOOD_TEST_RAIN_START=
FLOOD_RAIN_THRESHOLD_MM_HR=5
FLOOD_RAIN_LOOKAHEAD_HOURS=2
FLOOD_RAIN_TIMESTEP_MINUTES=15
# Cold-start a flood_mapping_full run unless the run of the previous 15-minute slot is success or running. Set 0 to always allow a hotstart.
FLOOD_COLD_START_AFTER_BREAK=1

# Host paths for the ./data bind mount and the airflow-logs volume. Pipeline data and task
# logs are batch/sequential I/O, not latency-sensitive, so these can point at a non-SSD
# drive to keep the SSD-backed Docker data disk from refilling. Leave unset to default to
# paths inside the repo (./data, ./.docker-volumes/airflow-logs) on whatever drive it's on.
DATA_HOST_PATH=
AIRFLOW_LOGS_HOST_PATH=

# 2b_archive_results copies results_3di.nc and a run record of each real-rain run to this host folder, which mounts at
# /opt/airflow/archive. Leave unset to use ./archive in the repo. The task fails when the drive has less than
# ARCHIVE_MIN_FREE_GB free (default 50).
ARCHIVE_HOST_PATH=
ARCHIVE_MIN_FREE_GB=50

STORAGE_FRONTEND_PORT=5173
STORAGE_BACKEND_PORT=8000
FLOODMAP_BACKEND_PORT=8010

PHOTON_BASE_URL=https://photon.komoot.io

# US-052. On: POST /route goes to the time-aware engine first (java/time-aware-routing) and falls back to today's request
# when the engine cannot run (a missing, stale, or mismatched depth table). The response says which, in its hints
# `td.status` and `td.reason`. Off, the default: today's behavior exactly. Turn it on only after the graphhopper image is
# built from java/time-aware-routing and a depth table is published (scripts/edge_depth).
TIME_AWARE_ROUTING=false
