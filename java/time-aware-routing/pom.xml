<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.t3digitaltwin</groupId>
    <artifactId>time-aware-routing</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>time-aware-routing</name>
    <description>Time-aware routing for the flood map, built against the pinned GraphHopper commit d7dc1b06.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- The pinned commit builds as 12.0-SNAPSHOT. CI installs it into ~/.m2 first, see .github/workflows/java-module.yml. -->
        <graphhopper.version>12.0-SNAPSHOT</graphhopper.version>
        <!-- The commit of the GraphHopper source that the module builds against. graph.json records it. -->
        <graphhopper.commit>d7dc1b069d2d091c7cfdc007d99d1765c82e618d</graphhopper.commit>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <!-- The image already has both on its classpath, in graphhopper-web.jar. -->
        <dependency>
            <groupId>com.graphhopper</groupId>
            <artifactId>graphhopper-core</artifactId>
            <version>${graphhopper.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.graphhopper</groupId>
            <artifactId>graphhopper-web-bundle</artifactId>
            <version>${graphhopper.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>time-aware-routing</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
