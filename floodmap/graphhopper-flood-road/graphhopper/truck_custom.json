// Verbatim copy of GraphHopper's bundled com/graphhopper/custom_models/truck.json, minus turn_costs
// (not configured on this profile — see config.yml).
{
  "distance_influence": 1,
  "priority": [
    { "if": "hgv == NO",  "multiply_by": "0" },
    { "if": "!car_access && road_access != PRIVATE && hgv != DELIVERY && hgv != DESTINATION",  "multiply_by": "0" },
    { "if": "hgv == DELIVERY || hgv == DESTINATION",  "multiply_by": "0.1" },
    { "if": "max_width < 3 || max_height < 4", "multiply_by": "0" },
    { "if": "max_weight < 18 && max_weight_except == MISSING", "multiply_by": "0" }
  ],
  "speed": [
    { "if": "road_environment == FERRY", "limit_to": "ferry_speed" },
    { "else": "", "limit_to": "car_average_speed * 0.9" },
    { "if": "true", "limit_to": "max_speed * 0.9" },
    { "if": "true", "limit_to": "95" }
  ]
}
