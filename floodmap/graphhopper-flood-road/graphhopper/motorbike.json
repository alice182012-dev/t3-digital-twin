// Hanoi is motorbike-dominated; GraphHopper ships this as com/graphhopper/custom_models/motorcycle.json
// (bundled in the jar, not exposed as a config-example.yml profile) — used verbatim here, unmodified,
// under the "motorbike" profile name to match VEHICLE_PROFILES in scripts/flood_utils.py.
{
  "distance_influence": 90,
  "priority": [
    { "if": "!car_access", "multiply_by": "0"},
    { "if": "track_type.ordinal() > 1", "multiply_by": "0" },
    { "if": "road_class == MOTORWAY || road_class == TRUNK", "multiply_by": "0.1" }
  ],
  "speed": [
    { "if": "road_environment == FERRY", "limit_to": "ferry_speed" },
    { "else": "", "limit_to": "0.9 * car_average_speed" },
    { "if": "true", "limit_to": "max_speed * 0.9" },
    { "if": "true", "limit_to": "120" },
    { "if": "surface==COBBLESTONE || surface==GRASS || surface==GRAVEL || surface==SAND || surface==PAVING_STONES || surface==DIRT || surface==GROUND || surface==UNPAVED || surface==COMPACTED",
      "limit_to": "30"
    }
  ]
}
